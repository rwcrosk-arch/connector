#!/usr/bin/env python3
"""connector-deck — admin console for the Hermes live-session connector.

Subcommands:
  status              links + recent hop counts
  tail                live tail of the audit log (the message flow)
  pause <linkId>      pause a link (fail-closed for the connector)
  resume <linkId>     resume a paused link
  kill <linkId>       kill a link (paused + flagged; unlink via hermes connector)
  serve [--port N]    loopback web view: live flow + character speech-bubble
                      stage (agents with animated bubbles per hop) + usage
                      evaluation stats
  smoke               post-update health check (read-only, exit 0/1)

stdlib only. Reads ~/.hermes/connector/{log.jsonl,links.json,control.json};
writes only control.json. Binds 127.0.0.1 only.

FUTURE (annotated per Ross's spec, do not build yet): a native Linux GUI app
with a system-tray icon + popup notifications when the connector is in use,
and a window mode showing each connector instance with agent labels
(Profile + session ID), animated characters and speech bubbles flowing per
message. The web deck's character stage (this file) is the design prototype
for that GUI: same event model, same label scheme.
"""
import argparse
import json
import os
import socket
import sys
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path

HOME = Path(os.path.expanduser(os.environ.get("HERMES_HOME", "~/.hermes")))
CONN = HOME / "connector"
LOG = CONN / "log.jsonl"
LINKS = CONN / "links.json"
CONTROL = CONN / "control.json"
TOKEN_FILE = CONN / "deck.token"


def read_json(path, default):
    try:
        return json.loads(path.read_text())
    except Exception:
        return default


def load_links():
    return read_json(LINKS, {"links": []}).get("links", [])


def control():
    c = read_json(CONTROL, {"paused_links": [], "killed_links": []})
    c.setdefault("paused_links", [])
    c.setdefault("killed_links", [])
    return c


def read_log_tail(n=200):
    if not LOG.exists():
        return []
    lines = LOG.read_text(errors="replace").splitlines()
    out = []
    for l in lines[-n:]:
        if l.strip():
            try:
                out.append(json.loads(l))
            except Exception:
                pass
    return out


def fmt_event(e):
    ts = time.strftime("%H:%M:%S", time.localtime(e.get("ts", 0)))
    if e.get("kind") == "admin":
        return f"{ts}  ADMIN  {e.get('action')} {e.get('link_id','')} {e.get('detail','')}"
    d = e.get("dir", "?")
    frm = e.get("from_key", e.get("from_title", "?")).split(":")[-1]
    to = e.get("to_key", "?").split(":")[-1]
    acc = "OK " if e.get("accepted") else ("REF" if e.get("kind") == "hop" else "?")
    reason = f" ({e['reason']})" if e.get("reason") else ""
    hops = f" hop{e.get('hops_in_exchange', '?')}" if e.get("kind") == "hop" else ""
    kind = f" [{e.get('link_kind','?')}]" if e.get("link_kind") else ""
    return f"{ts}  {d:3s} {frm} -> {to}{hops}{kind}  [{acc}]{reason}  {e.get('text_preview', '')[:90]}"


# ---- CLI subcommands ----

def cmd_status(_):
    c = control()
    links = load_links()
    print(f"{'id':22s} {'state':8s} {'kind':7s} {'control':8s} label")
    for l in links:
        ctl = "killed" if l["id"] in c["killed_links"] else ("paused" if l["id"] in c["paused_links"] else "-")
        print(f"{l['id']:22s} {l['state']:8s} {l.get('kind','crew'):7s} {ctl:8s} {l['label']}")
    if not links:
        print("(no links — create with: hermes connector link <keyA> <keyB>)")
    try:
        log_lines = read_log_tail(10)
        print(f"\nlast {len(log_lines)} events:")
        for e in log_lines:
            print("  " + fmt_event(e))
    except Exception:
        pass


def cmd_tail(args):
    import subprocess
    if not LOG.exists():
        print("no audit log yet — no hops have flowed")
        return
    print("tailing", LOG, "(ctrl-c to stop)")
    subprocess.run(["tail", "-n", str(args.lines), "-f", str(LOG)])


def _edit_control(link_id, key, add):
    c = control()
    lst = c[key]
    if add and link_id not in lst:
        lst.append(link_id)
    if not add and link_id in lst:
        lst.remove(link_id)
    tmp = CONTROL.with_suffix(".tmp")
    tmp.write_text(json.dumps(c, indent=1))
    os.replace(tmp, CONTROL)
    print(f"{key}: {link_id} {'added' if add else 'removed'}")


def cmd_pause(args):
    _edit_control(args.link_id, "paused_links", True)


def cmd_resume(args):
    _edit_control(args.link_id, "paused_links", False)


def cmd_kill(args):
    _edit_control(args.link_id, "paused_links", True)
    _edit_control(args.link_id, "killed_links", True)
    print("killed. also unlink with: hermes connector unlink", args.link_id)


# ---- usage evaluation (the human's "how is this being used" view) ----

def usage_stats(events=None, hours=24):
    """Aggregate the audit log for human evaluation of connector usage."""
    events = events if events is not None else read_log_tail(5000)
    cutoff = time.time() - hours * 3600
    hops = [e for e in events if e.get("kind") == "hop" and e.get("ts", 0) >= cutoff]
    refused = [e for e in hops if not e.get("accepted")]
    by_link = {}
    for e in hops:
        lid = e.get("link_id") or "unknown"
        d = by_link.setdefault(lid, {"hops": 0, "refused": 0, "chars": 0,
                                     "sessions": set(), "kinds": "crew"})
        if e.get("accepted"):
            d["hops"] += 1
            d["chars"] += len(e.get("text_preview") or "")
            d["sessions"].add(e.get("from_key", "?").split(":")[-1])
        else:
            d["refused"] += 1
        k = e.get("link_kind")
        if k:
            d["kinds"] = k
    return {
        "window_hours": hours,
        "total_hops": len(hops),
        "accepted_hops": len(hops) - len(refused),
        "refused_hops": len(refused),
        "by_link": {k: {"hops": v["hops"], "refused": v["refused"],
                        "chars_relayed": v["chars"],
                        "kind": v.get("kinds", "crew"),
                        "sessions": sorted(v["sessions"])}
                    for k, v in by_link.items()},
    }


def cmd_usage(args):
    s = usage_stats(hours=args.hours)
    print(f"connector usage, last {args.hours}h:")
    print(f"  accepted hops: {s['accepted_hops']}   refused: {s['refused_hops']}")
    if not s["by_link"]:
        print("  (no traffic)")
        return
    print(f"  {'link':22s} {'kind':8s} {'hops':>5s} {'ref':>4s} {'chars':>6s}  sessions")
    for lid, d in sorted(s["by_link"].items(), key=lambda kv: -kv[1]["hops"]):
        print(f"  {lid:22s} {d['kind']:8s} {d['hops']:5d} {d['refused']:4d} {d['chars_relayed']:6d}  {', '.join(d['sessions'][:4])}")


# ---- smoke (Phase 2.4) ----

def cmd_smoke(_):
    checks = []
    ok_all = True

    def run(name, fn):
        nonlocal ok_all
        try:
            ok, detail = fn()
        except Exception as e:
            ok, detail = False, f"error: {e}"
        print(f"  {'✓' if ok else '✗'} {name}: {detail}")
        if not ok:
            ok_all = False

    def db_schema():
        import sqlite3
        db = HOME / "state.db"
        if not db.exists():
            return False, "state.db missing"
        con = sqlite3.connect(f"file:{db}?mode=ro", uri=True)
        try:
            cols = {r[1] for r in con.execute("PRAGMA table_info(sessions)")}
            need = {"session_key", "source", "profile_name", "title", "last_activity_at"}
            missing = need - cols
            if missing:
                return False, f"columns missing: {sorted(missing)} — update SESSION_QUERY in the plugin"
            con.execute("SELECT session_key FROM sessions WHERE session_key IS NOT NULL LIMIT 1")
            return True, "schema matches"
        finally:
            con.close()

    def perm():
        text = (HOME / "config.yaml").read_text(errors="replace") if (HOME / "config.yaml").exists() else ""
        return ("allow_gateway_injection" in text, "grant present" if "allow_gateway_injection" in text
                else "plugins.entries.connector.allow_gateway_injection not set")

    def plugin():
        for root in (HOME / "plugins" / "connector", Path.cwd() / "connector"):
            if (root / "plugin.yaml").is_file():
                return True, f"found at {root}"
        return False, "connector plugin.yaml not found under ~/.hermes/plugins/"

    def gateway():
        sock = HOME / "gateway.sock"
        if not sock.exists():
            return False, "gateway.sock missing — gateway not running?"
        try:
            s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
            s.settimeout(2.0)
            s.connect(str(sock))
            s.sendall(json.dumps({"verb": "identify"}).encode() + b"\n")
            resp = json.loads(s.recv(65536).decode())
            return True, f"answered, pid={resp.get('result', {}).get('pid', '?')}"
        except Exception as e:
            return False, f"no answer: {e}"

    def logw():
        CONN.mkdir(parents=True, exist_ok=True)
        with open(LOG, "a"):
            pass
        return True, "writable"

    for name, fn in [("state.db session query", db_schema), ("injection permission", perm),
                     ("connector plugin installed", plugin), ("gateway control socket", gateway),
                     ("audit log writable", logw)]:
        run(name, fn)
    sys.exit(0 if ok_all else 1)


