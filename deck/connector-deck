def cmd_serve(args):
    token = TOKEN_FILE.read_text().strip() if TOKEN_FILE.exists() else None
    if not token:
        import secrets
        CONN.mkdir(parents=True, exist_ok=True)
        token = secrets.token_hex(16)
        TOKEN_FILE.write_text(token)
        os.chmod(TOKEN_FILE, 0o600)

    class Handler(BaseHTTPRequestHandler):
        def _auth(self):
            if self.headers.get("Authorization") == f"Bearer {token}":
                return True
            # token-in-query allowed on any path (loopback-only server)
            return f"t={token}" in self.path

        def do_GET(self):
            path = self.path.split("?")[0]
            if path == "/" or path.startswith("/?"):
                if f"t={token}" not in self.path and not self._auth():
                    return self._deny()
                body = PAGE.encode()
                self.send_response(200)
                self.send_header("Content-Type", "text/html")
                self.send_header("Content-Length", str(len(body)))
                self.end_headers()
                self.wfile.write(body)
            elif path == "/api/state":
                if not self._auth():
                    return self._deny()
                c = control()
                data = json.dumps({"links": load_links(), "control": c,
                                   "usage": usage_stats(hours=24)}).encode()
                self._json(data)
            elif path == "/api/recent":
                if not self._auth():
                    return self._deny()
                # replay window for page-load persistence: the last 5 minutes of hops,
                # newest last, so a refresh restores the stage instead of going blank.
                cutoff = time.time() - 300
                recent = [e for e in read_log_tail(400) if e.get("kind") == "hop" and e.get("ts", 0) >= cutoff]
                self._json(json.dumps({"events": recent}).encode())
            elif path == "/api/stream":
                if not self._auth():
                    return self._deny()
                self.send_response(200)
                self.send_header("Content-Type", "text/event-stream")
                self.send_header("Cache-Control", "no-cache")
                self.end_headers()
                try:
                    with open(LOG) as f:
                        f.seek(0, 2)
                        while True:
                            line = f.readline()
                            if line:
                                self.wfile.write(b"data: " + line.strip().encode() + b"\n\n")
                                self.wfile.flush()
                            else:
                                time.sleep(0.4)
                except (BrokenPipeError, ConnectionResetError):
                    pass
            else:
                self._deny()

        def do_POST(self):
            if not self._auth():
                return self._deny()
            path = self.path.split("?")[0]
            if path in ("/api/pause", "/api/resume", "/api/kill"):
                length = int(self.headers.get("Content-Length", 0))
                link_id = json.loads(self.rfile.read(length)).get("link", "")
                if path == "/api/pause":
                    _edit_control(link_id, "paused_links", True)
                elif path == "/api/resume":
                    _edit_control(link_id, "paused_links", False)
                else:
                    _edit_control(link_id, "paused_links", True)
                    _edit_control(link_id, "killed_links", True)
                self._json(b'{"ok": true}')
            else:
                self._deny()

        def _json(self, data):
            self.send_response(200)
            self.send_header("Content-Type", "application/json")
            self.send_header("Content-Length", str(len(data)))
            self.end_headers()
            self.wfile.write(data)

        def _deny(self):
            self.send_response(404)
            self.end_headers()

        def log_message(self, *_):
            pass

    srv = ThreadingHTTPServer(("127.0.0.1", args.port), Handler)
    print(f"deck: http://127.0.0.1:{args.port}/?t={token}")
    print("(loopback only. keep the token private.)")
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        pass


def main():
    p = argparse.ArgumentParser(description="connector admin deck")
    sub = p.add_subparsers(dest="cmd", required=True)
    sub.add_parser("status")
    t = sub.add_parser("tail")
    t.add_argument("--lines", type=int, default=50)
    u = sub.add_parser("usage")
    u.add_argument("--hours", type=int, default=24)
    for name in ("pause", "resume", "kill"):
        s = sub.add_parser(name)
        s.add_argument("link_id")
    sv = sub.add_parser("serve")
    sv.add_argument("--port", type=int, default=8765)
    sub.add_parser("smoke")
    args = p.parse_args()
    {"status": cmd_status, "tail": cmd_tail, "usage": cmd_usage,
     "pause": cmd_pause, "resume": cmd_resume, "kill": cmd_kill,
     "smoke": cmd_smoke, "serve": cmd_serve}[args.cmd](args)


if __name__ == "__main__":
    main()